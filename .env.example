# GitHub OAuth（不配置也能通过公开用户名读取 Star）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:8787/api/auth/github/callback

# 本地地址
APP_URL=http://127.0.0.1:5173
PORT=8787

# 可选：不填写时会自动在 data/session-secret 生成本地密钥
SESSION_SECRET=

# 中文分析（可选，推荐 DeepSeek）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Telegram 个人账号 API（从 https://my.telegram.org 的 API development tools 获取）
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
